<Application x:Class="WinDockIt.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>

    <!-- Colors are swapped at runtime by Theme.ApplyMenus (light/dark). -->
    <SolidColorBrush x:Key="Menu.Bg" Color="#F7F9F9FB"/>
    <SolidColorBrush x:Key="Menu.Border" Color="#1F000000"/>
    <SolidColorBrush x:Key="Menu.Fg" Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="Menu.Hover" Color="#14000000"/>
    <SolidColorBrush x:Key="Menu.Sep" Color="#1A000000"/>

    <DropShadowEffect x:Key="Menu.Shadow" BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.22"/>

    <Style TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="HasDropShadow" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource Menu.Fg}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Grid Margin="12,8,12,16">
              <Border Background="{DynamicResource Menu.Bg}" CornerRadius="10" Effect="{StaticResource Menu.Shadow}"/>
              <Border Background="{DynamicResource Menu.Bg}" BorderBrush="{DynamicResource Menu.Border}"
                      BorderThickness="1" CornerRadius="10" Padding="0,5">
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Margin="12,4" Background="{DynamicResource Menu.Sep}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource Menu.Fg}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Bd" Margin="5,0" Padding="8,6,10,6" CornerRadius="6" Background="Transparent">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="22"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="11" VerticalAlignment="Center" Visibility="Hidden"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center" MinWidth="140"/>
                <TextBlock x:Name="Arrow" Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="9" Margin="14,0,0,0" Opacity="0.65" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-4" VerticalOffset="-14"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                  <Grid Margin="12,8,12,16">
                    <Border Background="{DynamicResource Menu.Bg}" CornerRadius="10" Effect="{StaticResource Menu.Shadow}"/>
                    <Border Background="{DynamicResource Menu.Bg}" BorderBrush="{DynamicResource Menu.Border}"
                            BorderThickness="1" CornerRadius="10" Padding="0,5">
                      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                  </Grid>
                </Popup>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Menu.Hover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="HasItems" Value="True">
                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim, modern scroll bars: a thin rounded thumb, no arrows or track, a little wider on hover. -->
    <SolidColorBrush x:Key="Scroll.Thumb" Color="#59000000"/>
    <SolidColorBrush x:Key="Scroll.ThumbHover" Color="#8C000000"/>

    <Style x:Key="Scroll.ThumbStyle" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="T" CornerRadius="3" Background="{DynamicResource Scroll.Thumb}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="T" Property="Background" Value="{DynamicResource Scroll.ThumbHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Scroll.PageStyle" TargetType="RepeatButton">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="12"/>
      <Setter Property="MinWidth" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource Scroll.PageStyle}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource Scroll.PageStyle}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb x:Name="Thumb" Style="{StaticResource Scroll.ThumbStyle}" Width="4" MinHeight="32"
                         HorizontalAlignment="Center"/>
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Thumb" Property="Width" Value="7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <!-- Horizontal bars aren't used anywhere; keep them out of the way if one ever appears. -->
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="0"/>
        </Trigger>
      </Style.Triggers>
    </Style>

  </Application.Resources>
</Application>
